# 阿里云百炼 DashScope API Key（必填）
# 获取地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-api-key-here

# OpenAI API Key（可选，使用GPT模型时需要）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 和风天气 API Key（可选，用于天气查询工具）
# 免费申请: https://dev.qweather.com/
QWEATHER_API_KEY=

# 默认城市（天气查询使用）
DEFAULT_CITY=北京

# 操作者标识
OPERATOR_NAME=admin

# API 配置
API_HOST=0.0.0.0
API_PORT=8000

# A1: RAG handler 是否调用 LLM（false=只检索文档，generate 一次性生成，省 6-10s）
RAG_LLM_ENABLED=false

# A2: 意图分类模型（默认跟随 CHAT_MODEL=qwen-plus，可设为 qwen-turbo 提速）
# 注：turbo 在复合/边缘 query 上意图容易误判，建议保持 qwen-plus
INTENT_MODEL=qwen-plus

# C: 流式输出模式（invoke=节点级一次性输出, stream=token级SSE流式）
# 注：stream 已验证可行，但 DAG 预处理串行导致前 5s 无输出，默认 invoke 体验更好
STREAM_MODE=invoke
